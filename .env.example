# PostgreSQL Database connection string (automatically provided if using Render Blueprint, or copied from Render PostgreSQL instance)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# Secret key for JWT signing & session verification (Generate a random 32+ character string e.g. using `openssl rand -base64 32`)
JWT_SECRET="your_production_jwt_secret_random_string_here"

# Node environment mode (set to production for Render)
NODE_ENV="production"

# Port on which the application runs (Render automatically sets this to 10000)
PORT=10000

# Optional: Public domain URL of the deployed application
NEXT_PUBLIC_APP_URL="https://ironpulse-gym.onrender.com"
